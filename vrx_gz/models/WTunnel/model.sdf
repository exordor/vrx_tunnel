<?xml version="1.0"?>
<sdf version="1.8">
 <model name="WTunnel">
   <static>true</static>
   <link name="base_link">
     <!-- Disable complex mesh collision to avoid ODE AABB crash -->
     <visual name="visual">
       <pose>0 0 0 0 0 0</pose>
       <geometry>
         <mesh>
           <uri>model://WTunnel/meshes/tunnel.glb</uri>
         </mesh>
       </geometry>
     </visual>
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://WTunnel/meshes/tunnel.glb</uri>
          </mesh>
        </geometry>
      </collision>
   </link>
 </model>
</sdf>
