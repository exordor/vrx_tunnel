<?xml version="1.0"?>
<sdf version="1.9">
 <model name="tunnel10">
   <static>true</static>
   <link name="base_link">
     <!-- Disable complex mesh collision to avoid ODE AABB crash -->
     <visual name="visual">
       <laser_retro>100</laser_retro>
       <pose>0 0 0 0 0 0</pose>
       <geometry>
         <mesh>
           <uri>model://tunnel10/meshes/tunnel_viz.glb</uri>
         </mesh>
       </geometry>
     </visual>
      <collision name="collision">
        <pose>0 0 -0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://tunnel10/meshes/tunnel_col.glb</uri>
          </mesh>
        </geometry>
      </collision>
   </link>
 </model>
</sdf>