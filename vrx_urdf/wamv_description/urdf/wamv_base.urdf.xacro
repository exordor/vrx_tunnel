<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="wam-v">
  <!-- Required arg for melodic and kinetic... -->
  <xacro:arg name="namespace" default="wamv"/>
  <xacro:property name="namespace" value="$(arg namespace)" scope="global" />

  <!-- Desired hull dimensions in meters (length x width x height) -->
  <xacro:arg name="hull_length" default="0.72"/>
  <xacro:arg name="hull_width" default="0.80"/>
  <xacro:arg name="hull_height" default="0.44"/>

  <!-- Original geometry reference values (meters) -->
  <xacro:property name="target_length" value="$(arg hull_length)" scope="global" />
  <xacro:property name="target_width" value="$(arg hull_width)" scope="global" />
  <xacro:property name="target_height" value="$(arg hull_height)" scope="global" />
  <xacro:property name="orig_length" value="4.925" scope="global" />
  <xacro:property name="orig_height" value="1.30" scope="global" />
  <xacro:property name="float_radius_orig" value="0.2" scope="global" />
  <xacro:property name="float_offset_y_orig" value="1.03" scope="global" />

  <!-- Boat STL original dimensions captured in millimeters (720 x 800 x 440) -->
  <xacro:property name="mesh_length_orig" value="720.0" scope="global" />
  <xacro:property name="mesh_width_orig" value="800.0" scope="global" />
  <xacro:property name="mesh_height_orig" value="440.0" scope="global" />

  <!-- Scaling factors derived from target dimensions -->
  <xacro:property name="scale_x" value="${target_length / orig_length}" scope="global" />
  <xacro:property name="scale_z" value="${target_height / orig_height}" scope="global" />
  <xacro:property name="scale_y" value="${(target_width * 0.5 - float_radius_orig * scale_z) / float_offset_y_orig}" scope="global" />
  <xacro:property name="float_offset_y" value="${float_offset_y_orig * scale_y}" scope="global" />
  <xacro:property name="float_radius" value="${float_radius_orig * scale_z}" scope="global" />
  <xacro:property name="scale_volume" value="${scale_x * scale_y * scale_z}" scope="global" />
  <xacro:property name="mass_scale" value="${scale_volume}" scope="global" />
  <xacro:property name="inertia_scale_x" value="${scale_volume * (scale_y * scale_y + scale_z * scale_z) / 2.0}" scope="global" />
  <xacro:property name="inertia_scale_y" value="${scale_volume * (scale_x * scale_x + scale_z * scale_z) / 2.0}" scope="global" />
  <xacro:property name="inertia_scale_z" value="${scale_volume * (scale_x * scale_x + scale_y * scale_y) / 2.0}" scope="global" />
  <xacro:property name="mesh_scale_x" value="${target_length / (mesh_length_orig * 1.0)}" scope="global" />
  <xacro:property name="mesh_scale_y" value="${target_width / (mesh_width_orig * 1.0)}" scope="global" />
  <xacro:property name="mesh_scale_z" value="${target_height / (mesh_height_orig * 1.0)}" scope="global" />
  <xacro:property name="center_offset" value="${target_height / 2.0}" scope="global" />
  <!-- Macro for creating the main collisions as simple shapes. -->
  <xacro:macro name="main_collisions" params="prefix reflect:=1">
    <!-- Main float -->
    <collision name="${prefix}_float">
      <origin xyz="${-0.4*scale_x} ${float_offset_y*reflect} ${0.2*scale_z - center_offset}" rpy="${0*reflect} 1.57 0" />
      <geometry>
        <cylinder length="${4*scale_x}" radius="${float_radius}" />
      </geometry>
    </collision>

    <collision name="${prefix}_mid_float">
      <origin xyz="${1.85*scale_x} ${float_offset_y*reflect} ${0.3*scale_z - center_offset}" rpy="${0*reflect} 1.38 0" />
      <geometry>
        <cylinder length="${0.5*scale_x}" radius="${0.17*scale_z}" />
      </geometry>
    </collision>
    <collision name="${prefix}_front_float">
      <origin xyz="${2.3*scale_x} ${float_offset_y*reflect} ${0.4*scale_z - center_offset}" rpy="${0*reflect} 1.3 0" />
      <geometry>
        <cylinder length="${0.45*scale_x}" radius="${0.12*scale_z}" />
      </geometry>
    </collision>

    <!-- Front beam -->
    <collision name="front_${prefix}_beam_lower">
      <origin xyz="${0.9*scale_x} ${0.85*scale_y*reflect} ${1.0*scale_z - center_offset}" rpy="${0.78*reflect} 0 0" />
      <geometry>
        <cylinder length="${0.5*scale_y}" radius="${0.04*scale_z}" />
      </geometry>
    </collision>

    <collision name="front_${prefix}_beam_upper">
      <origin xyz="${0.9*scale_x} ${0.6*scale_y*reflect} ${1.18*scale_z - center_offset}" rpy="${1.35*reflect} 0 0" />
      <geometry>
        <cylinder length="${0.2*scale_y}" radius="${0.04*scale_z}" />
      </geometry>
    </collision>

    <!-- Mid beam -->
    <collision name="mid_${prefix}_beam_lower">
      <origin xyz="${-0.65*scale_x} ${0.99*scale_y*reflect} ${0.7*scale_z - center_offset}" rpy="${0.1*reflect} 0.25 0" />
      <geometry>
        <cylinder length="${0.45*scale_y}" radius="${0.03*scale_z}" />
      </geometry>
    </collision>

    <collision name="mid_${prefix}_beam_medium">
      <origin xyz="${-0.57*scale_x} ${0.87*scale_y*reflect} ${1.05*scale_z - center_offset}" rpy="${0.75*reflect} 0.25 0" />
      <geometry>
        <cylinder length="${0.32*scale_y}" radius="${0.03*scale_z}" />
      </geometry>
    </collision>

    <collision name="mid_${prefix}_beam_upper">
      <origin xyz="${-0.55*scale_x} ${0.65*scale_y*reflect} ${1.17*scale_z - center_offset}" rpy="${1.35*reflect} 0.25 0" />
      <geometry>
        <cylinder length="${0.3*scale_y}" radius="${0.03*scale_z}" />
      </geometry>
    </collision>

    <!-- Rear beam -->
    <collision name="rear_${prefix}_beam_lower">
      <origin xyz="${-0.74*scale_x} ${float_offset_y*reflect} ${0.7*scale_z - center_offset}" rpy="${0*reflect} -0.15 0" />
      <geometry>
        <cylinder length="${0.45*scale_y}" radius="${0.03*scale_z}" />
      </geometry>
    </collision>

    <collision name="rear_${prefix}_beam_medium">
      <origin xyz="${-0.79*scale_x} ${0.91*scale_y*reflect} ${1.05*scale_z - center_offset}" rpy="${0.75*reflect} -0.15 0" />
      <geometry>
        <cylinder length="${0.32*scale_y}" radius="${0.03*scale_z}" />
      </geometry>
    </collision>

    <collision name="rear_${prefix}_beam_upper">
      <origin xyz="${-0.81*scale_x} ${0.67*scale_y*reflect} ${1.18*scale_z - center_offset}" rpy="${1.45*reflect} -0.15 0" />
      <geometry>
        <cylinder length="${0.3*scale_y}" radius="${0.03*scale_z}" />
      </geometry>
    </collision>

    <!-- Joint -->
    <collision name="${prefix}_joint">
      <origin xyz="${0.58*scale_x} ${float_offset_y*reflect} ${0.6*scale_z - center_offset}" rpy="${0*reflect} -0.6 0" />
      <geometry>
        <box size="${0.65*scale_x} ${0.2*scale_y} ${0.1*scale_z}" />
      </geometry>
    </collision>
  </xacro:macro>

  <!-- Basic model of the 16' WAM-V USV -->
  <link name="${namespace}/base_link">
    <visual>
      <origin xyz="0 0 ${-center_offset}" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wamv_description/models/BoatBase/meshes/boat.stl" scale="${mesh_scale_x} ${mesh_scale_y} ${mesh_scale_z}"/>
      </geometry>
    </visual>

    <!-- Left base collisions -->
    <xacro:main_collisions prefix="left" reflect="1" />

    <!-- Right side collisions -->
    <xacro:main_collisions prefix="right" reflect="-1" />

     <!-- Top base -->
    <collision name="top_base">
      <origin xyz="0 0 ${1.25*scale_z - center_offset}" rpy="0 0 0" />
      <geometry>
        <box size="${1.85*scale_x} ${1.0*scale_y} ${0.1*scale_z}" />
      </geometry>
    </collision>

    <inertial>
      <!-- From WAM-V spec sheet -->
      <mass value="${180.0 * mass_scale}"/>
      <inertia ixx="${120.0 * inertia_scale_x}" ixy="0.0" ixz="0.0" iyy="${393.0 * inertia_scale_y}" iyz="0.0" izz="${446.0 * inertia_scale_z}"/>
    </inertial>
  </link>

  <gazebo>
    <enable_wind>true</enable_wind>
  </gazebo>

  <gazebo reference="${namespace}/base_link">
    <visual>
      <material>
        <diffuse>1.0 1.0 1.0</diffuse>
        <specular>1.0 1.0 1.0</specular>
        <pbr>
          <metal>
            <albedo_map>model://wamv_description/models/WAM-V-Base/mesh/WAM-V_Albedo.png</albedo_map>
            <normal_map>model://wamv_description/models/WAM-V-Base/mesh/WAM-V_Normal.png</normal_map>
            <roughness_map>model://wamv_description/models/WAM-V-Base/mesh/WAM-V_Roughness.png</roughness_map>
            <metalness_map>model://wamv_description/models/WAM-V-Base/mesh/WAM-V_Metalness.png</metalness_map>
          </metal>
        </pbr>
      </material>
    </visual>

    <sensor type="contact" name="contact_sensor">
      <contact>
        <!-- collisions are renamed during urdf -> sdf fixed joint lumping -->
        <collision>${namespace}/base_link_fixed_joint_lump__top_base_collision_24</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__left_float_collision</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__left_mid_float_collision_1</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__left_front_float_collision_2</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__right_float_collision_12</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__right_mid_float_collision_13</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__right_front_float_collision_14</collision>
        <topic>/vrx/contacts</topic>
      </contact>
      <always_on>1</always_on>
      <update_rate>5</update_rate>
    </sensor>
  </gazebo>


</robot>
