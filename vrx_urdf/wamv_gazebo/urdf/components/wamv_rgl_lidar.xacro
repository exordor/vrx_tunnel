<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Macro to insert an RGL-based custom LIDAR with ROS integration -->
  <xacro:macro name="wamv_rgl_lidar" params="name
                                            x:=0.7 y:=0 z:=1.8
                                            R:=0 P:=0 Y:=0
                                            update_rate:=10
                                            min_range:=0.2 max_range:=60
                                            update_on_paused_sim:=true
                                            topic:=scan_omni
                                            frame:=''
                                            pattern_preset_path:=''
                                            plugin_filename:='RGLServerPluginInstance'
                                            plugin_name:='rgl::RGLServerPluginInstance'">

    <!-- Always bind the plugin frame to the actual link frame to ensure TF alignment.
         Note: The optional 'frame' arg is ignored to avoid mismatches like
         'front_lidar_link' vs the real link name 'RGLLidar_front_link'. -->
    <xacro:property name="lidar_frame" value="${namespace + '/' + name + '_link'}"/>

    <!-- Lidar body link (reuses simple cylinder mass/inertia like 3d lidar) -->
    <link name="${namespace}/${name}_link">
      <visual>
        <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.055" length="0.075"/>
        </geometry>
      </visual>
      <collision name="${name}_collision">
        <geometry>
          <cylinder radius="0.055" length="0.075"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.001225" iyy="0.001225" izz="0.0015125" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${namespace}/base_to_${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}" />
      <parent link="${namespace}/base_link" />
      <child link="${namespace}/${name}_link" />
    </joint>

    <!-- Custom sensor with RGL plugin -->
    <gazebo reference="${namespace}/${name}_link">
      <sensor name="${name}_sensor" type="custom">
        <pose>0 0 0 0 0 0</pose>
        <plugin filename="${plugin_filename}" name="${plugin_name}">
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
          </range>
          <update_rate>${update_rate}</update_rate>
          <update_on_paused_sim>${update_on_paused_sim}</update_on_paused_sim>
          <topic>${topic}</topic>
          <frame>${lidar_frame}</frame>
          <pattern_preset_path>${pattern_preset_path}</pattern_preset_path>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
